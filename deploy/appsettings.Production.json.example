// ============================================================
//  把这个文件复制成 appsettings.Production.json 放在程序目录下，填上真实值。
//  它已经在 .gitignore 里，不会进版本库。
//
//  只写「要覆盖的键」就行 —— 没写的键沿用 appsettings.json 里的值。
//  下面是 Linux 部署（nginx 反代 + 程序跑 5000）的配置。
// ============================================================
{
  // nginx 终止 TLS，程序只监听回环，外网碰不到它 —— 比绑 0.0.0.0 安全
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://127.0.0.1:5000" },
      // 桌面端 MaxChemic 如果是直连 9080（不经 nginx），这里要留 0.0.0.0；
      // 如果桌面端改走 https://域名/dtuhub，就把这行删掉
      "Hub9080": { "Url": "http://0.0.0.0:9080" }
    }
  },

  // 绝对路径。/var/lib/dtuserver 是 systemd 里唯一可写的目录，
  // SQLite 要在同目录建 -wal/-shm，所以给的是目录权限不是文件权限
  "ConnectionStrings": {
    "Default": "Data Source=/var/lib/dtuserver/maxchemic.db"
  },

  // 桌面端 MaxChemic 的接入令牌，要和桌面 RemoteServerSettings.AccessToken 一致
  "Hub": { "AccessToken": "从 Windows 那台的 appsettings 里抄过来" },

  // 桌面端「上云」上传工艺组态的密钥
  "Process": { "UploadKey": "从 Windows 那台抄过来" },

  // 32 字符以上随机串。换了它所有已签发的 API 令牌会失效，
  // 迁移时直接沿用 Windows 那台的值，不要重新生成
  "Jwt": { "Secret": "从 Windows 那台抄过来" },

  // 网关拉物模型配置的令牌。生产上必须非空，
  // 否则任何人都能按序列号枚举出你的设备配置
  "GatewayConfigPull": { "AccessToken": "从 Windows 那台抄过来" },

  // 二维码里的绑定链接、物模型自动填充的地址都用它。必须是外网能访问的地址
  "PublicBaseUrl": "https://cloud.sh-htlab.com",

  "Mqtt": {
    "Enabled": true,
    "Broker": "post-cn-xxxxxxxx.mqtt.aliyuncs.com",
    "Port": 1883,
    "InstanceId": "post-cn-xxxxxxxx",
    // 必须是阿里云控制台里已创建的 Group
    "GroupId": "GID_DEVICE",
    // 完整 clientId = {GroupId}@@@{ClientSuffix}。
    // ⚠️ 和 Windows 那台**必须不同**，否则两边会互相把对方踢下线
    "ClientSuffix": "platform-linux",
    "AccessKey": "阿里云 AccessKey",
    "SecretKey": "阿里云 SecretKey"
  }
}
