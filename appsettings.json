// ============================================================
//  模板配置 —— 这个文件进版本库，只放结构和安全默认值，不放任何密钥。
//
//  真实值放同目录的 appsettings.Production.json（已在 .gitignore 里）。
//  ASP.NET Core 不设 ASPNETCORE_ENVIRONMENT 时默认环境就是 Production，
//  那个文件会自动按键路径叠加覆盖本文件 —— 只需要写要改的键，不用整份抄。
//  每台机器（Windows 生产 / Linux 生产 / 开发机）各有各的 Production 文件，互不影响。
//
//  注：ASP.NET Core 的 JSON 配置读取器允许 // 注释和尾随逗号，这些注释不会报错。
// ============================================================
{
  // ── 监听端口 ──
  // 这里给的是非特权端口，克隆下来 dotnet run 直接能跑，不需要 root。
  // 生产环境的 80/443 在各自的 appsettings.Production.json 里覆盖：
  //   Windows：可以直接绑 80/443
  //   Linux  ：<1024 是特权端口，需要 nginx 反代或给服务授 CAP_NET_BIND_SERVICE，见部署文档
  "Kestrel": {
    "Endpoints": {
      // 网页 + API + SignalR
      "Http": { "Url": "http://0.0.0.0:5000" },
      // 桌面端 MaxChemic 连 /dtuhub 用的备用端口
      "Hub9080": { "Url": "http://0.0.0.0:9080" }
      // HTTPS 不在模板里配，因为证书路径每台机器都不一样。
      // 需要 Kestrel 自己终止 TLS 时，在 Production 文件里加：
      //   "Https": { "Url": "https://0.0.0.0:443",
      //              "Certificate": { "Path": "...", "Password": "..." } }
    }
  },

  // SQLite 单文件库。相对路径 → 相对于进程的工作目录，
  // systemd 下由 WorkingDirectory= 决定，务必和部署文档保持一致。
  "ConnectionStrings": {
    "Default": "Data Source=maxchemic.db"
  },

  // ── DTU 透传链路（裸 TCP，不走 HTTP，不能挂反向代理）──
  "DtuServer": {
    "ListenPort": 9116,        // DTU 连入端口，要与 DTU 里的「服务器端口号」一致
    "LoginTimeoutMs": 15000,   // 连上后多久没发登录包就断开
    "HeartbeatTimeoutMs": 0    // >0 才启用「长时间无收包判离线」兜底；0=只靠读循环检测断线
  },

  // 桌面端 MaxChemic 连 /dtuhub 的接入令牌。留空=不校验（仅本地联调）。
  "Hub": {
    "AccessToken": ""
  },

  // 桌面端「上云」上传工艺组态的密钥。留空=不校验（仅内网）。
  "Process": {
    "UploadKey": ""
  },

  // ── MQTT 接入（设备接入网关 + 手机 APP 那条链路）──
  // 与上面的 DTU 透传完全平行。Enabled=false 时本服务空转，对老部署零影响。
  // AccessKey / SecretKey 绝不写在这里 —— 放 Production 文件。
  "Mqtt": {
    "Enabled": false,
    "Broker": "",
    "Port": 1883,
    "UseTls": false,
    "AuthMode": "aliyun",       // aliyun=签名鉴权 / basic=用户名密码（自建 EMQX 等）
    "InstanceId": "",
    "GroupId": "GID_SERVER",    // 必须是阿里云控制台里已创建的 Group
    "ClientSuffix": "platform", // 完整 clientId = {GroupId}@@@{ClientSuffix}，多实例部署不能重名
    "AccessKey": "",
    "SecretKey": "",
    "Username": "",
    "Password": "",
    "KeepAliveSeconds": 60,
    "CommandTimeoutMs": 10000,      // 下发指令后等回执的超时
    "OfflineTimeoutMs": 180000,     // 多久收不到上报就判离线
    "ReconnectInitialDelayMs": 5000,
    "ReconnectMaxDelayMs": 120000,
    "DebugLogAllTopics": false,     // 排障开关：额外订阅 device/# 并打印每条消息的 Topic，查完记得关
    "Topics": {
      "DeviceData": "device/{deviceId}/data",
      "Command": "device/{deviceId}/command",
      "CommandReply": "device/{deviceId}/command/reply",
      "Alarm": "device/{deviceId}/alarm",
      "Online": "device/{deviceId}/online",
      "ConfigUpdate": "config/update/{productKey}"
    }
  },

  // 网关拉物模型配置的令牌（经 X-Access-Token 头传）。留空=不校验。
  // 生产上务必在 Production 文件里设成非空，否则任何人都能按序列号枚举出设备配置。
  "GatewayConfigPull": {
    "AccessToken": ""
  },

  // 开放 API 的 JWT 签名密钥。留空或不足 32 字符时程序会回退到内置开发密钥并告警，
  // 生产上必须在 Production 文件里设一个 32 字符以上的随机串。
  "Jwt": {
    "Secret": "",
    "TtlMinutes": 720
  },

  // 首次启动时播种的管理员账号。Password 留空则自动生成一个临时密码并打进日志。
  "Admin": {
    "Username": "admin",
    "Password": "",
    "Email": ""
  },

  // 对外可访问的基础地址。二维码里的绑定链接、物模型里自动填充的回调地址都用它，
  // 必须是设备和手机真正能访问到的地址，不能填内网 IP。
  "PublicBaseUrl": "",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
