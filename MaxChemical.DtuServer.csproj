<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MaxChemical.DtuServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 正斜杠在 Windows 和 Linux 的 MSBuild 下都认;反斜杠只有 Windows 认 -->
    <Content Include="Properties/PublishProfiles/launchSettings.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web SDK 默认把 **/*.json 都当 Content 发布出去,appsettings.Production.json 会被一起带走。
         这个文件是「机器专属」的:证书路径、SQLite 路径、MQTT ClientSuffix 每台都不一样,
         跟着产物跑到另一台机器上全是错的 —— 尤其 ClientSuffix 撞了,
         两台服务器会在阿里云上互相把对方踢下线,现象是反复「连上又断」。
         所以只禁止进发布产物,不禁止进 bin(本机 dotnet run 照常读得到)。
         每台机器的这个文件都在部署时手工放置。 -->
    <Content Update="appsettings.Production.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- 系统服务托管:两个包各管一个平台,在对方平台上是空操作,同一份产物两边都能跑 -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.7.3" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- MQTT 客户端(设备接入网关链路)。锁 4.3.x:5.x 把 MqttFactory 改名成 MqttClientFactory,升级要改代码。 -->
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
  </ItemGroup>

</Project>
